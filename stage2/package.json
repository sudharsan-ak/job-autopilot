{
  "name": "application-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP workflow for safely preparing job applications without submitting them.",
  "type": "module",
  "main": "dist/src/mcp/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/mcp/server.js",
    "dev": "tsx src/mcp/server.ts",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "test:interaction": "npm run build && node --test dist/tests/interaction_engine.test.js",
    "check": "npm test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^25.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
